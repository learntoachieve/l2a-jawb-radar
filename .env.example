JAWB_ACTIVE_USER=loris

# Database backend: sqlite (default) or postgres
JAWB_DB_BACKEND=sqlite
JAWB_SQLITE_PATH=data/jawb.db

# Postgres (for hosted deployment)
# DATABASE_URL=postgresql://user:password@host:5432/jawbdb

# Adzuna API (scraper)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Anthropic (industry classifier)
ANTHROPIC_API_KEY=
